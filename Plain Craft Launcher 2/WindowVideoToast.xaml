<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="WindowVideoToast"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
    WindowStartupLocation="Manual" Width="280" Height="72"
    Focusable="False" IsHitTestVisible="False" SnapsToDevicePixels="True"
    Title="录制提示">
    <!-- 窗口本身固定在屏幕右边缘不动；黑底跟着内容一起从边缘滑出，避免逐帧移动整个窗口 -->
    <Grid x:Name="PanRoot" Background="#FF000000" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PanSlide" X="288" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <!-- 左侧主题色竖条 -->
        <Rectangle Grid.Column="0" Fill="{DynamicResource ColorBrush3}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,12,0">
            <!-- 带缺口的圆环 + 圆点 -->
            <Grid Width="30" Height="30" VerticalAlignment="Center">
                <!-- 录制：带缺口的圆环 + 圆点 -->
                <Grid x:Name="IcoRecord">
                    <Path Stroke="{DynamicResource ColorBrush3}" StrokeThickness="3.4" Stretch="Uniform"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 20.7,36.9 A 15,15 0 1 1 30.6,34.3" />
                    <Ellipse Fill="{DynamicResource ColorBrush3}" Width="7" Height="7"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <!-- 截屏：相机 -->
                <Path x:Name="IcoCamera" Visibility="Collapsed" Fill="{DynamicResource ColorBrush3}" Stretch="Uniform"
                      Data="M3,8 L6.5,8 L8,5.5 L16,5.5 L17.5,8 L21,8 A1.5,1.5 0 0 1 22.5,9.5 L22.5,18.5 A1.5,1.5 0 0 1 21,20 L3,20 A1.5,1.5 0 0 1 1.5,18.5 L1.5,9.5 A1.5,1.5 0 0 1 3,8 Z M12,10 A3.5,3.5 0 1 0 12,17 A3.5,3.5 0 1 0 12,10 Z M12,12 A1.5,1.5 0 1 0 12,15 A1.5,1.5 0 1 0 12,12 Z" />
            </Grid>
            <TextBlock x:Name="LabTitle" Text="录制已开始" FontSize="14.5" Foreground="#FFFFFFFF"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>
    </Grid>
</Window>

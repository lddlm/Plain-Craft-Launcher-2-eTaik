<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:behaviors="clr-namespace:PCL.Controls.Behaviors"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <local:MyHint x:Name="PanHint" RelativeSetup="HintSnapshot" Theme="Blue" CanClose="True" Margin="0,0,0,15"
                          Text="快照版 PCL 包含尚未正式发布的测试功能，仅限赞助者自己使用。&#xa;请不要随意发给其他人，或是用来制作整合包哦！" />
            <local:MyCard x:Name="CardSkin" Margin="0,0,0,15" Title="皮肤管理" Visibility="Collapsed" AllowDrop="True"
                        DragOver="CardSkin_DragOver" Drop="CardSkin_Drop">
                <Grid Margin="25,40,25,20">
                    <!-- 常规视图 -->
                    <Grid x:Name="PanSkinHome">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="92" Height="92" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ColorBrushGray7}"
                                BorderBrush="{DynamicResource ColorBrush3}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="LabSkinEmpty" Text="无预览" FontSize="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{StaticResource ColorBrushGray3}" />
                                <Image x:Name="ImgSkinPreview" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock x:Name="LabSkinStatus" FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource ColorBrushGray3}" />
                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource ColorBrushGray4}"
                                       Text="从本地导入皮肤文件（也可直接拖到这张卡上），或在下方皮肤库点一个。勾选「同步到游戏」会把它复制进 Quick Skin 的 quickskin/skins 目录，进游戏后在快捷皮肤菜单里选中即可。" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <local:MyButton x:Name="BtnSkinImport" Text="导入皮肤…" Height="30" Padding="14,5"
                                                ColorType="Highlight" Margin="0,0,10,0" />
                                <local:MyButton x:Name="BtnSkinFolder" Text="打开皮肤文件夹" Height="30" Padding="12,5" Margin="0,0,10,0" />
                                <local:MyButton x:Name="BtnSkinClose" Text="收起" Height="30" Padding="12,5" />
                            </StackPanel>
                            <local:MyCheckBox x:Name="CheckSkinSync" Height="22" Margin="0,14,0,0"
                                              Text="同步到游戏（需要 Quick Skin 模组）" />
                        </StackPanel>
                        <!-- 已有皮肤：横向一字排开，点一下切换；右上角「管理」里点格子删除 -->
                        <StackPanel x:Name="PanSkinLocalBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0"
                                    Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LabSkinLocalHint" Text="已有皮肤（点一下切换）" FontSize="12"
                                           VerticalAlignment="Center" Foreground="{StaticResource ColorBrushGray3}" />
                                <local:MyButton x:Name="BtnSkinManage" Grid.Column="1" Text="管理" Height="26"
                                                Padding="14,0" VerticalAlignment="Center" />
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Margin="0,8,0,0">
                                <StackPanel x:Name="PanSkinLocal" Orientation="Horizontal" />
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </Grid>
            </local:MyCard>
            <!-- 皮肤库：独立一张卡片，直接挂在皮肤管理下面 -->
            <local:MyCard x:Name="CardSkinLib" Margin="0,0,0,15" Title="皮肤库" Visibility="Collapsed">
                <Grid Margin="25,40,25,20">
                    <Grid x:Name="PanSkinLib">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MySearchBox x:Name="SearchSkinLib" Grid.Column="0" VerticalAlignment="Center"
                                               HintText="搜索皮肤名称" />
                            <local:MyButton x:Name="BtnSkinLibSearch" Grid.Column="1" Text="搜索" Height="32" Padding="16,0"
                                            Margin="10,0,0,0" ColorType="Highlight" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="来源：" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource ColorBrushGray3}" />
                                <local:MyRadioButton x:Name="RadioSourcePhoto2Skin" Text="photo2skin" ColorType="Highlight"
                                                     Checked="True" Margin="0,0,4,0" />
                                <local:MyRadioButton x:Name="RadioSourceLittleSkin" Text="LittleSkin" ColorType="Highlight" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,10,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <local:MyRadioButton x:Name="RadioSkinNewest" Text="最新" Tag="newest" ColorType="Highlight"
                                                     Checked="True" Margin="0,0,4,0" />
                                <local:MyRadioButton x:Name="RadioSkinHot" Text="热门" Tag="views" ColorType="Highlight" Margin="0,0,4,0" />
                                <local:MyRadioButton x:Name="RadioSkinLikes" Text="点赞" Tag="likes" ColorType="Highlight" Margin="0,0,4,0" />
                                <local:MyRadioButton x:Name="RadioSkinDownloads" Text="下载" Tag="downloads" ColorType="Highlight" />
                            </StackPanel>
                            <TextBlock x:Name="LabSkinLibStatus" Grid.Column="1" FontSize="11" Margin="10,0,0,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource ColorBrushGray3}" Text="正在加载…" />
                        </Grid>
                        <ScrollViewer Grid.Row="3" Height="352" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <WrapPanel x:Name="PanSkinLibList" />
                        </ScrollViewer>
                        <Grid Grid.Row="4" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnSkinLibPrev" Grid.Column="0" Text="上一页" Height="30" Padding="16,0" />
                            <TextBlock x:Name="LabSkinLibPage" Grid.Column="1" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource ColorBrushGray3}" Text="第 1 / 1 页" />
                            <local:MyButton x:Name="BtnSkinLibNext" Grid.Column="2" Text="下一页" Height="30" Padding="16,0" />
                        </Grid>
                    </Grid>
                </Grid>
            </local:MyCard>
            <StackPanel x:Name="PanCustom">
            </StackPanel>
            <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog">
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

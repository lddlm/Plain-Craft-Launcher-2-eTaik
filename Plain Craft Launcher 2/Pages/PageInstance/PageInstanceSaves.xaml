<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageInstanceSaves"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,0,0,15" Title="存档管理">
                <StackPanel Margin="25,40,25,25">
                    <TextBlock FontSize="13" Foreground="{DynamicResource ColorBrush3}" TextWrapping="Wrap"
                               Text="管理当前版本的单人游戏存档：点击存档即可在下方展开详情，查看游戏版本与实体统计，并可删除存档或自定义封面。" />
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <local:MyButton x:Name="BtnRefresh" Text="刷新列表" MinWidth="110" Padding="12,0" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnOpenFolder" Text="打开存档文件夹" MinWidth="130" Padding="12,0" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="世界列表">
                <StackPanel Margin="12,40,12,15">
                    <TextBlock x:Name="LabEmpty" Text="当前版本还没有存档。" FontSize="13" Foreground="{DynamicResource ColorBrush3}"
                               HorizontalAlignment="Center" Margin="0,20" Visibility="Collapsed" />
                    <StackPanel x:Name="PanSaves" />
                </StackPanel>
            </local:MyCard>

            <!-- 存档详情：全程只有一份实例，点哪条存档就把它移动到那条的正下方 -->
            <Border x:Name="PanDetail" Visibility="Collapsed" Margin="0,2,0,10" Padding="16"
                    CornerRadius="8" Background="{DynamicResource ColorBrush8}">
                <StackPanel>
                    <TextBlock x:Name="LabDetailTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock x:Name="LabDetailInfo" FontSize="12.5" Margin="0,8,0,0" LineHeight="21" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnChangeCover" Text="更改封面" MinWidth="104" Padding="12,0" Margin="0,0,10,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnRename" Text="存档改名" MinWidth="104" Padding="12,0" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnOpenSave" Text="打开文件夹" MinWidth="104" Padding="12,0" Margin="0,0,10,0" />
                        <local:MyButton x:Name="BtnDelete" Text="删除存档" MinWidth="104" Padding="12,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

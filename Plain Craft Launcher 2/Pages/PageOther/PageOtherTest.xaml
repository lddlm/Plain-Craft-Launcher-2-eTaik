<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageOtherTest"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="百宝箱">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnJrrp" Text="今日人品" Height="34" Margin="0,0,8,0" />
                        <local:MyButton x:Name="BtnMemory" Grid.Column="1" Text="内存优化" Height="34" Margin="4,0,4,0" />
                        <local:MyButton x:Name="BtnRubbish" Grid.Column="2" Text="清理游戏垃圾" Height="34" Margin="4,0,4,0" />
                        <local:MyButton x:Name="BtnDontClick" Grid.Column="3" Height="34" Margin="8,0,0,0">
                            <Run Text="千万别点" Foreground="#FF4C4C" />
                        </local:MyButton>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="回声洞">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="反复点击这里可以查看 PCL 作者与各位沙雕网友乱七八糟的留言！" TextWrapping="Wrap"
                               Foreground="{StaticResource ColorBrushGray3}" />
                    <TextBlock x:Name="LabCave" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="14" />
                    <local:MyTextButton x:Name="BtnCave" Text="再听一条回声……" Margin="0,12,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="下载自定义文件">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="使用 PCL 的高速多线程下载引擎下载任意文件。请注意，部分网站（例如百度网盘）可能会报错（403）已禁止，无法正常下载。"
                               TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="下载地址" VerticalAlignment="Center" />
                        <local:MyTextBox x:Name="TextUrl" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                                         HintText="https://example.com/file.zip" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="保存到" VerticalAlignment="Center" />
                        <local:MyTextBox x:Name="TextFolder" Grid.Column="1" Height="32" VerticalContentAlignment="Center" />
                        <local:MyButton x:Name="BtnSelectFolder" Grid.Column="2" Text="选择" Height="32" Width="64" Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文件名" VerticalAlignment="Center" />
                        <local:MyTextBox x:Name="TextFileName" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                                         HintText="留空则从链接中自动推断" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <local:MyButton x:Name="BtnDownload" Text="开始下载" Height="34" Width="150" ColorType="Highlight" Margin="0,0,12,0" />
                        <local:MyButton x:Name="BtnOpenFolder" Text="打开文件夹" Height="34" Width="150" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageToolScreenshot"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">

            <!-- 截屏开关与状态 -->
            <local:MyCard Title="截屏" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="最近截屏" Margin="0,0,25,0" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LabLast" Text="还没有截过屏" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource ColorBrushGray3}" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="保存位置" Margin="0,0,25,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LabFolder" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource ColorBrushGray3}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <local:MyButton x:Name="BtnShot" Text="立即截屏" Height="34" Width="132" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnOpenFolder" Text="打开 photo 文件夹" Height="34" Padding="15,0" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="LabRange" Text="" Margin="0,12,0,0" FontSize="12.5"
                               Foreground="{StaticResource ColorBrushGray3}" />
                    <TextBlock x:Name="LabHotkeyTip" Text=""
                               Margin="0,13,0,0" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                               Foreground="{StaticResource ColorBrushGray3}" />
                </StackPanel>
            </local:MyCard>

            <!-- 截屏参数 -->
            <local:MyCard Title="截屏设置" Margin="0,0,0,15">
                <StackPanel Margin="25,40,25,25">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition x:Name="RowHeight" Height="28" />
                            <RowDefinition x:Name="RowHeightGap" Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="截屏范围" Margin="0,0,25,0" />
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <local:MyRadioBox local:SettingService.Key="ScreenshotMode" local:SettingService.Value="0"
                                              x:Name="RadioFullScreen" Text="全屏" Height="22" VerticalAlignment="Center"
                                              ToolTip="截取整个主屏幕，游戏全屏或窗口化都不影响。" />
                            <local:MyRadioBox local:SettingService.Key="ScreenshotMode" local:SettingService.Value="1"
                                              x:Name="RadioGameWindow" Text="锁定游戏窗口" Height="22"
                                              Margin="36,0,0,0" VerticalAlignment="Center"
                                              ToolTip="只截游戏的画面区域，不含桌面上的其他窗口。&#xa;没找到游戏窗口时自动改为全屏。" />
                            <local:MyRadioBox local:SettingService.Key="ScreenshotMode" local:SettingService.Value="2"
                                              x:Name="RadioRegion" Text="区域" Height="22"
                                              Margin="36,0,0,0" VerticalAlignment="Center"
                                              ToolTip="只截自己框出来的一块屏幕区域，按框选的原尺寸输出。&#xa;每次截屏时都会让你重新框选一次。" />
                        </StackPanel>

                        <TextBlock x:Name="LabHeightLabel" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="分辨率" Margin="0,0,25,0" />
                        <local:MyComboBox local:SettingService.Key="ScreenshotHeight" x:Name="ComboHeight"
                                          Grid.Row="2" Grid.Column="1" ToolTip="输出图片的高度，宽度按画面比例自动计算。&#xa;「跟随原画」不缩放，画质最完整。">
                            <local:MyComboBoxItem Content="跟随原画" local:SettingService.Value="0" />
                            <local:MyComboBoxItem Content="2160p（4K）" local:SettingService.Value="2160" />
                            <local:MyComboBoxItem Content="1440p（2K）" local:SettingService.Value="1440" />
                            <local:MyComboBoxItem Content="1080p" local:SettingService.Value="1080" />
                            <local:MyComboBoxItem Content="720p" local:SettingService.Value="720" />
                        </local:MyComboBox>

                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="图片格式" Margin="0,0,25,0" />
                        <local:MyComboBox local:SettingService.Key="ScreenshotFormat" x:Name="ComboFormat"
                                          Grid.Row="4" Grid.Column="1" ToolTip="PNG 无损、体积大，适合截图；JPG 体积小，适合分享。">
                            <local:MyComboBoxItem Content="PNG（无损，推荐）" local:SettingService.Value="0" />
                            <local:MyComboBoxItem Content="JPG（体积小）" local:SettingService.Value="1" />
                        </local:MyComboBox>

                        <local:MyCheckBox local:SettingService.Key="ScreenshotCursor" x:Name="CheckCursor"
                                          Grid.Row="6" Grid.ColumnSpan="2" Text="包含鼠标指针" Height="22" Margin="0,6,0,0"
                                          ToolTip="把当前鼠标指针一起画进图片。关掉后截出来的画面更干净。" />
                        <local:MyCheckBox local:SettingService.Key="ScreenshotToast" x:Name="CheckToast"
                                          Grid.Row="8" Grid.ColumnSpan="2" Text="截屏后显示「已截屏」提示条" Height="22"
                                          ToolTip="和录制一样的右上角提示条，几秒后自动消失。提示条本身不会被截进图片。" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
